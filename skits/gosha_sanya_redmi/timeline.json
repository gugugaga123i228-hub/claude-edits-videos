{
"lines": [
{
"who": "N",
"key": "N0",
"idx": 0,
"src": "np_.wav",
"a": 0,
"b": 3.27,
"t0": 0.3,
"t1": 3.57,
"text": "Гоша и Саня. Битва телефонов."
},
{
"who": "S",
"key": "S0",
"idx": 0,
"src": "s2.wav",
"a": 0,
"b": 3.24,
"t0": 3.92,
"t1": 7.16,
"text": "Гоша, зацени, нахуй! Айфон Дуо!"
},
{
"who": "G",
"key": "G0",
"idx": 0,
"src": "g.wav",
"a": 0,
"b": 1.5,
"t0": 7.3100000000000005,
"t1": 8.81,
"text": "Чё это за хуйня?"
},
{
"who": "S",
"key": "S1",
"idx": 1,
"src": "s2.wav",
"a": 4.51,
"b": 9.68,
"t0": 8.96,
"t1": 14.13,
"text": "Два айфона в одном, блять! Два экрана, четыре камеры, двести косарей!"
},
{
"who": "G",
"key": "G1",
"idx": 1,
"src": "g.wav",
"a": 2.87,
"b": 6.22,
"t0": 14.280000000000001,
"t1": 17.630000000000003,
"text": "Сань... у меня Редми девять А."
},
{
"who": "S",
"key": "S2",
"idx": 2,
"src": "s2.wav",
"a": 10.700000000000001,
"b": 15.06,
"t0": 17.78,
"t1": 22.14,
"text": "Чего?! Редми девять А?! Ты серьёзно, блять?!"
},
{
"who": "G",
"key": "G2",
"idx": 2,
"src": "g.wav",
"a": 7.13,
"b": 10.51,
"t0": 22.29,
"t1": 25.669999999999998,
"text": "Чё?! Ты, блять, вообще понимаешь, с кем разговариваешь?!"
},
{
"who": "S",
"key": "S3",
"idx": 3,
"src": "s2.wav",
"a": 16.169999999999998,
"b": 18.389999999999997,
"t0": 25.82,
"t1": 28.04,
"text": "С лохом с Редми, вот с кем!"
},
{
"who": "G",
"key": "G3",
"idx": 3,
"src": "g.wav",
"a": 11.46,
"b": 14.27,
"t0": 28.189999999999998,
"t1": 30.999999999999996,
"text": "С владельцем Редми девять А, сука!"
},
{
"who": "N",
"key": "N1",
"idx": 1,
"src": "np_.wav",
"a": 4.72,
"b": 11.2,
"t0": 31.149999999999995,
"t1": 37.629999999999995,
"text": "Редми девять А. Год выпуска — двадцатый. Скорость — неизвестна науке."
},
{
"who": "S",
"key": "S4",
"idx": 4,
"src": "s2.wav",
"a": 19.61,
"b": 24.08,
"t0": 37.98,
"t1": 42.449999999999996,
"text": "Да он у тебя Инстаграм минуту грузит, сука! Это кирпич, а не телефон!"
},
{
"who": "G",
"key": "G4",
"idx": 4,
"src": "g.wav",
"a": 15.3,
"b": 19.38,
"t0": 42.599999999999994,
"t1": 46.67999999999999,
"text": "Это не лагает. Это он думает. Он умнее тебя, Саня."
},
{
"who": "S",
"key": "S5",
"idx": 5,
"src": "s2.wav",
"a": 25.43,
"b": 31.59,
"t0": 46.82999999999999,
"t1": 52.989999999999995,
"text": "Какая нахуй камера?! Там тринадцать мегапикселей, блять! У меня микроволновка лучше снимает!"
},
{
"who": "G",
"key": "G5",
"idx": 5,
"src": "g.wav",
"a": 20.349999999999998,
"b": 26.659999999999997,
"t0": 53.13999999999999,
"t1": 59.44999999999999,
"text": "Тринадцать мегапикселей за каждым, блять, пикселем! Я им Луну сфоткал — НАСА мне до сих пор пишет!"
},
{
"who": "S",
"key": "S6",
"idx": 6,
"src": "s2.wav",
"a": 32.64,
"b": 35.04,
"t0": 59.599999999999994,
"t1": 61.99999999999999,
"text": "Пиздёж! Пиздёж, блять!"
},
{
"who": "G",
"key": "G6",
"idx": 6,
"src": "g.wav",
"a": 27.709999999999997,
"b": 31.47,
"t0": 62.14999999999999,
"t1": 65.91,
"text": "Я его в двадцатом году зарядил. Сейчас девяносто девять процентов."
},
{
"who": "S",
"key": "S7",
"idx": 7,
"src": "s2.wav",
"a": 36.08,
"b": 38.58,
"t0": 66.05999999999999,
"t1": 68.55999999999999,
"text": "Там пять тыщ миллиампер, долбоёб!"
},
{
"who": "G",
"key": "G7",
"idx": 7,
"src": "g.wav",
"a": 32.35,
"b": 34.1,
"t0": 68.71,
"t1": 70.46,
"text": "Пять тыщ миллиардов!"
},
{
"who": "G",
"key": "G8",
"idx": 8,
"src": "g.wav",
"a": 34.99,
"b": 39.01,
"t0": 70.61,
"t1": 74.63,
"text": "Он у меня с девятого этажа упал. Асфальт, нахуй, в ремонт увезли."
},
{
"who": "S",
"key": "S8",
"idx": 8,
"src": "s2.wav",
"a": 39.62,
"b": 43.5,
"t0": 74.78,
"t1": 78.66,
"text": "Да у меня ГТА шесть на ультрах летает, а у тебя змейка лагает!"
},
{
"who": "G",
"key": "G9",
"idx": 9,
"src": "g.wav",
"a": 39.75,
"b": 43.85,
"t0": 78.81,
"t1": 82.91,
"text": "А у меня на Редми ГТА семь идёт. Её ещё даже не выпустили."
},
{
"who": "RING",
"key": "RING",
"t0": 83.06,
"t1": 84.66
},
{
"who": "G",
"key": "G10",
"idx": 10,
"src": "g.wav",
"a": 44.699999999999996,
"b": 48.73,
"t0": 84.81,
"t1": 88.84,
"text": "О. Илон Маск. Опять просит ракету через мой Редми запустить."
},
{
"who": "S",
"key": "S9",
"idx": 9,
"src": "s2.wav",
"a": 44.47,
"b": 51.19,
"t0": 88.99000000000001,
"t1": 95.71000000000001,
"text": "Какой нахуй Маск?! Твой Редми — кусок говна! Айфон Дуо — лучший телефон в мире, понял, нищеброд?!"
},
{
"who": "G",
"key": "X0",
"idx": 0,
"src": "g2.wav",
"a": 0.14,
"b": 2.17,
"t0": 95.86000000000001,
"t1": 97.89000000000001,
"text": "Ты чё сказал про мой Редми?.."
},
{
"who": "G",
"key": "X1",
"idx": 1,
"src": "g2.wav",
"a": 3.52,
"b": 5.15,
"t0": 98.04000000000002,
"t1": 99.67000000000002,
"text": "ЛОВИ, СУКА!"
},
{
"who": "THROW",
"key": "THROW",
"t0": 99.82000000000002,
"t1": 101.52000000000002
},
{
"who": "S",
"key": "S10",
"idx": 10,
"src": "s2.wav",
"a": 52.37,
"b": 55.42,
"t0": 101.67000000000002,
"t1": 104.72000000000003,
"text": "Ааа... айфон... дуо..."
},
{
"who": "N",
"key": "N2",
"idx": 2,
"src": "np_.wav",
"a": 12.47,
"b": 16.93,
"t0": 104.87000000000002,
"t1": 109.33000000000001,
"text": "Редми девять А. Айфоны отдыхают."
}
],
"dur": 110.88000000000002
}